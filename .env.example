# Copy this file to .env. Never commit .env or clinical data.
ORTHANC_URL=https://orthanc.example.org
ORTHANC_USERNAME=
ORTHANC_PASSWORD=
# Keep true for production. Set false only for a documented private test server.
ORTHANC_VERIFY_TLS=true
ORTHANC_TIMEOUT_SECONDS=120

MONAI_LABEL_URL=http://127.0.0.1:8000
MONAI_LABEL_TIMEOUT_SECONDS=1800

# Local paths, relative to the repository root unless absolute.
CT_NIFTI_DIR=data/ct
RADIOLOGIST_MASK_DIR=data/radiologist_masks
PREDICTION_DIR=data/predictions
REPORT_DIR=reports
